---
import "../styles/global.css";
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.jsx";
import { Image } from "astro:assets";
import AuthorImage from "../assets/about/author-image.png";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>About Me | Drew Voss</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body
    class="bg-nord-darkest text-nord-ice min-h-screen font-sans selection:bg-nord-border flex flex-col"
  >
    <Navbar client:load />

    <main
      class="max-w-6xl mx-auto p-8 grid grid-cols-1 md:grid-cols-10 gap-8 text-nord-snow"
    >
      <aside
        class="md: col-span-4 bg-nord-dark rounded mb-6 items-center justify-center"
      >
        <div
          class="aspect-square bg-nord-border rounded mb-2 items-center justify-center"
        >
          <Image
            src={AuthorImage}
            alt="Image of the author standing down the hill from the capital of Wisconsin, in Madison, WI."
          />
        </div>
        <div>
          <ul class="space-y-3 mb-6 p-4">
            <li><strong>Location: Madison, WI</strong></li>
            <li>
              <strong
                >Education: Graduating from UW-Madison w/ CS degree in December
                2026</strong
              >
            </li>
            <li>
              <strong>Current Position: IT Co-op at J.H. Findorff & Son</strong>
            </li>
            <h3 class="font-bold border-b border-nord-border pb-2 mb-3">
              Current Projects:
            </h3>
            <ul
              class="space-y-1 list-disc list-inside text-sm text-nord-snow p-4"
            >
              <li>Proxmox Homelab</li>
              <li>Garage Tracker</li>
              <li>Portfolio Site</li>
              <li>Segway Ninebot G30LP Custom Firmware</li>
            </ul>
          </ul>
        </div>
      </aside>
      <section class="md: col-span-6 p-8 space-y-8">
        <div>
          <h2 class="text-3xl font-bold text-nord-snow mb-4">Who I Am</h2>
          <p class="text-lg text-nord-ice leading-relaxed">
            My name is Drew Voss and I am currently a computer science student
            at UW-Madison, planning to graduate in December 2026. I enjoy
            programming, as well as working on electronics and cars. I've always
            loved to understand how things work, as a symptom of that, I love to
            disassemble things and try to figure them out. I also love to fix
            things and make my own solutions, this has led to me picking up a
            few other hobbies like 3D printing, soldering, working on cars, and
            hobby programming for some games I enjoy.
          </p>
        </div>
        <div>
          <h3 class="text-2xl font-semibold text-nord-snow mb-3">
            Professional Experience
          </h3>
          <p class="text-lg text-nord-ice leading-relaxed">
            I currently work at Findorff as an IT Co-op, my duties range from
            helpdesk tickets to designing internal websites, scripts, and basic
            programs. A lot of my work lies in automation of existing systems. I
            enjoy programming my own solutions through Powershell, Python, or
            other languages. While my current professional experience lies in
            troubleshooting, hardware repair, and scripting, with some
            larger-scale programming, I also have an interest in software
            engineering, systems administration, networking, and cybersecurity.
          </p>
        </div>
      </section>
    </main>
    <Footer client:load />
  </body>
</html>
